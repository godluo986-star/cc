# ─── Nexus Park server configuration ─────────────────────────────────────────
# Copy this file to `.env` in the repository root (or export the variables) and
# adjust values. Nothing here is required for a local dev run — every variable
# has a safe default — but you MUST set a strong JWT_SECRET for anything
# beyond local experimentation.

# Port the HTTP + WebSocket server listens on.
PORT=8080

# Bind address. Use 0.0.0.0 to accept connections from other machines on your
# network (e.g. to test multiplayer from a second device).
HOST=127.0.0.1

# Secret used to sign JSON Web Tokens. If left unset, the server generates a
# random secret on first boot and stores it in server/data/jwt-secret so that
# sessions survive restarts. Set it explicitly in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Path of the SQLite database file, relative to the server/ directory.
# The whole database lives inside the project folder; deleting the repo
# removes all data.
DB_PATH=./data/nexuspark.db

# Comma-separated list of allowed browser origins for CORS + WebSocket
# origin checks in development. The production server serves the client
# itself, so same-origin requests always work.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated STUN servers handed to clients for WebRTC voice chat.
STUN_SERVERS=stun:stun.l.google.com:19302

# Log verbosity: silent | error | info | debug
LOG_LEVEL=info
